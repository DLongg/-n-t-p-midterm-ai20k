# Mặc định bỏ qua mọi file và thư mục ở ngoài gốc (chỉ giữ vlearn-app)
/*

# Cho phép theo dõi file .gitignore và thư mục vlearn-app
!/.gitignore
!/vlearn-app/

# Bỏ qua các thư mục phụ thuộc và bản build bên trong vlearn-app
vlearn-app/node_modules/
vlearn-app/dist/
vlearn-app/dist-ssr/
vlearn-app/*.local
vlearn-app/*.log
